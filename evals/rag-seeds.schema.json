{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zixu.local/schemas/rag-seeds.schema.json",
  "title": "中文 RAG 评测种子集",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset", "version", "language", "seeds"],
  "properties": {
    "dataset": {"const": "d1-zh-rag-seeds"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "language": {"const": "zh-CN"},
    "seeds": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/seed"}
    }
  },
  "$defs": {
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "category",
        "question",
        "contexts",
        "expected_answer",
        "expected_citations",
        "tags"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^rag-zh-\\d{3}$"},
        "status": {"const": "draft"},
        "category": {"type": "string", "minLength": 2},
        "question": {"type": "string", "minLength": 5},
        "contexts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 5}
        },
        "expected_answer": {"type": "string", "minLength": 2},
        "expected_citations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

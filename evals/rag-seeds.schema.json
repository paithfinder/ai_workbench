{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zixu.local/schemas/rag-seeds.schema.json",
  "title": "中文 RAG 检索评测种子集",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset", "version", "language", "seeds"],
  "properties": {
    "dataset": {"const": "d1-zh-rag-seeds"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "language": {"const": "zh-CN"},
    "seeds": {
      "type": "array",
      "minItems": 30,
      "items": {"$ref": "#/$defs/seed"}
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "include_descendants"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"},
        "include_descendants": {"type": "boolean"}
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "category",
        "question",
        "scope",
        "contexts",
        "expected_answer",
        "expected_citations",
        "expected_content_identities",
        "expected_section_ids",
        "difficult_negative_content_identities",
        "out_of_scope_content_identities",
        "should_abstain",
        "allow_general_supplement",
        "tags"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^rag-zh-\\d{3}$"},
        "status": {"const": "draft"},
        "category": {"type": "string", "minLength": 2},
        "question": {"type": "string", "minLength": 5},
        "scope": {"$ref": "#/$defs/scope"},
        "contexts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 5}
        },
        "expected_answer": {"type": "string", "minLength": 2},
        "expected_citations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "expected_content_identities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "expected_section_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "difficult_negative_content_identities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "out_of_scope_content_identities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "should_abstain": {"type": "boolean"},
        "allow_general_supplement": {"const": false},
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

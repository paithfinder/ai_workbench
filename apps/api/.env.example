# The API launcher only binds to a loopback interface.
# Prefer the repository-root .env.example as the complete local configuration template.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://ai_workbench@127.0.0.1:5432/ai_workbench
# OPENAI_API_KEY is optional until model-backed runs are enabled.
# OPENAI_API_KEY=
# CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
LOG_LEVEL=INFO

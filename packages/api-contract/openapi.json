{
  "components": {
    "schemas": {
      "BootstrapResponse": {
        "properties": {
          "capabilities": {
            "$ref": "#/components/schemas/CapabilityResponse"
          },
          "foundation_status": {
            "const": "ready",
            "default": "ready",
            "title": "Foundation Status",
            "type": "string"
          },
          "space": {
            "$ref": "#/components/schemas/KnowledgeSpaceResponse"
          },
          "statistics": {
            "$ref": "#/components/schemas/BootstrapStatistics"
          }
        },
        "required": [
          "space",
          "capabilities",
          "statistics"
        ],
        "title": "BootstrapResponse",
        "type": "object"
      },
      "BootstrapStatistics": {
        "properties": {
          "activity_events": {
            "title": "Activity Events",
            "type": "integer"
          },
          "queued_jobs": {
            "title": "Queued Jobs",
            "type": "integer"
          },
          "sources": {
            "title": "Sources",
            "type": "integer"
          }
        },
        "required": [
          "sources",
          "queued_jobs",
          "activity_events"
        ],
        "title": "BootstrapStatistics",
        "type": "object"
      },
      "CapabilityResponse": {
        "properties": {
          "evidence_agent": {
            "default": false,
            "title": "Evidence Agent",
            "type": "boolean"
          },
          "extraction_review": {
            "default": false,
            "title": "Extraction Review",
            "type": "boolean"
          },
          "knowledge_tree": {
            "default": false,
            "title": "Knowledge Tree",
            "type": "boolean"
          },
          "source_import": {
            "default": true,
            "title": "Source Import",
            "type": "boolean"
          },
          "spaced_review": {
            "default": false,
            "title": "Spaced Review",
            "type": "boolean"
          },
          "trusted_qa": {
            "default": false,
            "title": "Trusted Qa",
            "type": "boolean"
          }
        },
        "title": "CapabilityResponse",
        "type": "object"
      },
      "CompleteUploadResponse": {
        "properties": {
          "job": {
            "$ref": "#/components/schemas/JobReferenceResponse"
          },
          "source": {
            "$ref": "#/components/schemas/SourceResponse"
          },
          "version": {
            "$ref": "#/components/schemas/SourceVersionResponse"
          }
        },
        "required": [
          "source",
          "version",
          "job"
        ],
        "title": "CompleteUploadResponse",
        "type": "object"
      },
      "CreateSourceRequest": {
        "properties": {
          "kind": {
            "enum": [
              "pdf",
              "markdown",
              "text"
            ],
            "title": "Kind",
            "type": "string"
          },
          "title": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "title"
        ],
        "title": "CreateSourceRequest",
        "type": "object"
      },
      "DependencyStatus": {
        "properties": {
          "database": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Database",
            "type": "string"
          },
          "object_storage": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Object Storage",
            "type": "string"
          },
          "redis": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Redis",
            "type": "string"
          }
        },
        "required": [
          "database",
          "redis",
          "object_storage"
        ],
        "title": "DependencyStatus",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Details",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "JobReferenceResponse": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "title": "JobReferenceResponse",
        "type": "object"
      },
      "JobResponse": {
        "properties": {
          "attempt_count": {
            "title": "Attempt Count",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "progress": {
            "title": "Progress",
            "type": "integer"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          },
          "source_version_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Version Id"
          },
          "space_id": {
            "format": "uuid",
            "title": "Space Id",
            "type": "string"
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "space_id",
          "source_version_id",
          "kind",
          "status",
          "progress",
          "attempt_count",
          "retryable",
          "error_code",
          "error_message",
          "started_at",
          "finished_at",
          "created_at",
          "updated_at"
        ],
        "title": "JobResponse",
        "type": "object"
      },
      "KnowledgeSpaceResponse": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "name"
        ],
        "title": "KnowledgeSpaceResponse",
        "type": "object"
      },
      "LivenessResponse": {
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "LivenessResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "dependencies": {
            "$ref": "#/components/schemas/DependencyStatus"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "dependencies"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "ReserveUploadRequest": {
        "properties": {
          "content_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Content Sha256",
            "type": "string"
          },
          "media_type": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Media Type",
            "type": "string"
          },
          "original_filename": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Original Filename",
            "type": "string"
          },
          "size_bytes": {
            "exclusiveMinimum": 0.0,
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "original_filename",
          "media_type",
          "size_bytes",
          "content_sha256"
        ],
        "title": "ReserveUploadRequest",
        "type": "object"
      },
      "SourceListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SourceResponse"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "SourceListResponse",
        "type": "object"
      },
      "SourceResponse": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "space_id": {
            "format": "uuid",
            "title": "Space Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "space_id",
          "kind",
          "title",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "SourceResponse",
        "type": "object"
      },
      "SourceVersionListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SourceVersionResponse"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "SourceVersionListResponse",
        "type": "object"
      },
      "SourceVersionResponse": {
        "properties": {
          "completed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "content_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Sha256"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "media_type": {
            "title": "Media Type",
            "type": "string"
          },
          "original_filename": {
            "title": "Original Filename",
            "type": "string"
          },
          "parse_status": {
            "title": "Parse Status",
            "type": "string"
          },
          "processing_status": {
            "title": "Processing Status",
            "type": "string"
          },
          "size_bytes": {
            "title": "Size Bytes",
            "type": "integer"
          },
          "source_id": {
            "format": "uuid",
            "title": "Source Id",
            "type": "string"
          },
          "upload_expires_at": {
            "format": "date-time",
            "title": "Upload Expires At",
            "type": "string"
          },
          "version_number": {
            "title": "Version Number",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "source_id",
          "version_number",
          "original_filename",
          "media_type",
          "size_bytes",
          "content_sha256",
          "processing_status",
          "parse_status",
          "upload_expires_at",
          "completed_at",
          "created_at"
        ],
        "title": "SourceVersionResponse",
        "type": "object"
      },
      "UploadReservationResponse": {
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "upload_fields": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Upload Fields",
            "type": "object"
          },
          "upload_headers": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Upload Headers",
            "type": "object"
          },
          "upload_url": {
            "title": "Upload Url",
            "type": "string"
          },
          "version": {
            "$ref": "#/components/schemas/SourceVersionResponse"
          }
        },
        "required": [
          "version",
          "upload_url",
          "upload_headers",
          "upload_fields",
          "expires_at"
        ],
        "title": "UploadReservationResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "D2 source ingestion API for the personal knowledge management workbench.",
    "title": "Zixu Knowledge Workbench API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/bootstrap": {
      "get": {
        "operationId": "get_bootstrap",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootstrapResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Bootstrap",
        "tags": [
          "bootstrap"
        ]
      }
    },
    "/api/v1/knowledge-spaces/default": {
      "get": {
        "operationId": "get_default_knowledge_space",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeSpaceResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Default Space",
        "tags": [
          "bootstrap"
        ]
      }
    },
    "/api/v1/knowledge-spaces/{space_id}/jobs/{job_id}": {
      "get": {
        "operationId": "get_job",
        "parameters": [
          {
            "in": "path",
            "name": "space_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Space Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Get Job",
        "tags": [
          "jobs"
        ]
      }
    },
    "/api/v1/knowledge-spaces/{space_id}/jobs/{job_id}/retry": {
      "post": {
        "operationId": "retry_job",
        "parameters": [
          {
            "in": "path",
            "name": "space_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Space Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Job Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 255,
              "minLength": 1,
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Retry Job",
        "tags": [
          "jobs"
        ]
      }
    },
    "/api/v1/knowledge-spaces/{space_id}/sources": {

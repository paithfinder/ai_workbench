# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (project-local development values only)
POSTGRES_DB=knowledge_workbench
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=knowledge_dev
DATABASE_URL=postgresql+asyncpg://knowledge:knowledge_dev@postgres:5432/knowledge_workbench

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO / S3
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=knowledge-sources
S3_SECURE=false

# AI (D1 uses Fake only; no credential is required)
AI_PROVIDER=fake
CLAUDE_MODEL=claude-opus-5

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
INTERNAL_API_BASE_URL=http://api:8000

# Application
APP_NAME=Zixu Knowledge Workbench API
APP_VERSION=0.1.0
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL (project-local development values only)
POSTGRES_DB=knowledge_workbench
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=knowledge_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Optional explicit override. When set, DATABASE_URL takes priority over POSTGRES_* components.
# DATABASE_URL=postgresql+asyncpg://knowledge:knowledge_dev@postgres:5432/knowledge_workbench

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO / S3
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=knowledge-sources
S3_SECURE=false
S3_PRESIGN_TTL_SECONDS=900
MAX_UPLOAD_SIZE_BYTES=26214400

# Direct text and safe web capture
MAX_PASTED_TEXT_SIZE_BYTES=1048576
WEB_FETCH_CONNECT_TIMEOUT_SECONDS=5.0
WEB_FETCH_TOTAL_TIMEOUT_SECONDS=15.0
WEB_FETCH_MAX_BODY_BYTES=5242880
WEB_FETCH_MAX_REDIRECTS=5

# Celery / jobs / outbox
CELERY_BROKER_URL=redis://redis:6379/1
JOB_ATTEMPT_LEASE_SECONDS=300
INDEX_HEARTBEAT_SECONDS=30
OUTBOX_RELAY_INTERVAL_SECONDS=1.0
OUTBOX_BATCH_SIZE=50

# D7 retrieval index
CHUNKER_VERSION=d7-structured-v1
CHUNK_TARGET_CHARACTERS=1800
CHUNK_OVERLAP_CHARACTERS=240
INDEX_VERSION=d7-v1
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_URL=http://localhost:8080/v1/embeddings
EMBEDDING_TIMEOUT_SECONDS=30
RETRIEVAL_DEFAULT_TOP_K=10

# D3 parsing. PARSE_OCR_LANGUAGES is a JSON array for pydantic-settings.
PARSE_ATTEMPT_LEASE_SECONDS=1800
PARSE_HEARTBEAT_SECONDS=30
PARSE_TIMEOUT_SECONDS=1800
PARSE_MAX_PAGES=200
PARSE_MAX_SOURCE_BYTES=26214400
PARSE_ENABLE_OCR=true
PARSE_OCR_LANGUAGES=["en","zh"]
PARSE_ARTIFACT_PREFIX=artifacts
PARSER_NAME=docling
PARSER_VERSION=2.117.0

# AI extraction. Use AI_PROVIDER=anthropic with server-side credentials for real Claude calls.
AI_PROVIDER=fake
CLAUDE_MODEL=claude-opus-5
AI_TIMEOUT_SECONDS=120
EXTRACTION_MAX_OUTPUT_TOKENS=16000
EXTRACTION_BATCH_MAX_CHARACTERS=24000
# ANTHROPIC_API_KEY=

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
INTERNAL_API_BASE_URL=http://api:8000

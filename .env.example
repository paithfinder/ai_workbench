# Application
APP_NAME=AI Workbench
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_VERSION=0.1.0
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# PostgreSQL (development only; replace before non-local use)
POSTGRES_USER=ai_workbench
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=ai_workbench
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ai_workbench:replace-with-a-local-password@127.0.0.1:5432/ai_workbench

# Model configuration (optional on Day 1)
OPENAI_MODEL=gpt-5.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Store the real key in Windows Credential Manager; this variable is a local-development fallback.
OPENAI_API_KEY=

# Local repository scanner (fail-closed hard limits)
REPOSITORY_SCAN_MAX_DIRECTORIES=5000
REPOSITORY_SCAN_MAX_FILES=20000
REPOSITORY_SCAN_MAX_ENTRIES=100000
REPOSITORY_SCAN_MAX_DEPTH=40
REPOSITORY_SCAN_MAX_FILE_BYTES=2097152
REPOSITORY_SCAN_MAX_TOTAL_BYTES=104857600
REPOSITORY_SCAN_TIMEOUT_SECONDS=30

# Web
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
